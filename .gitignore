# OS
.DS_Store
Thumbs.db

# Env / secrets
.env
.env.*
!.env.example
frontend/.env*
*.pem

# Node (frontend)
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*

# Gradle / Java (backend)
backend/.gradle/
backend/build/
backend/out/
*.class

# Python (ai)
ai/__pycache__/
**/__pycache__/
*.py[cod]
ai/.venv/
ai/venv/
ai/.ruff_cache/
ai/dist/
ai/*.egg-info/

# Data — 원본(raw)은 로컬 보존, 저장소에는 미포함 (스펙 §2-2: raw/ 보존 원칙은 로컬·팀 드라이브)
ai/data/raw/*
!ai/data/raw/.gitkeep
!ai/data/raw/README.md
ai/data/interim/*
!ai/data/interim/.gitkeep
# 예외: 정책자금 원문 텍스트(128KB)는 **근거 자료**다 — 부록 1 「근거 충실도」의 verbatim 대조가
# 이 파일들을 읽으므로, 없으면 신규 클론에서 `make eval` 이 지표를 0으로 산출한다.
# README 가 약속하는 재현 가능성이 여기에 달려 있다 (#72).
!ai/data/interim/funding_docs/
!ai/data/interim/funding_docs/*.txt

# Eval 산출물 (부록 확정본만 docs/에 복사)
ai/eval/out/

# IDE
.idea/
.vscode/
*.iml
