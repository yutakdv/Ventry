.DS_Store
Thumbs.db

# Env / secrets
.env
.env.local
*.pem

# Node (frontend)
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*

# Gradle / Java (backend)
backend/.gradle/
backend/build/
backend/out/
