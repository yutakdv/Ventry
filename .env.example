# 복사해서 .env 로 사용 (git 미추적)

# --- PostgreSQL (docker compose) ---
POSTGRES_DB=ventry
POSTGRES_USER=ventry
POSTGRES_PASSWORD=ventry-local

# --- Backend (Spring Boot) ---
# D3 이후 JDBC 도입 시 사용
DB_URL=jdbc:postgresql://db:5432/ventry
DB_USER=ventry
DB_PASSWORD=ventry-local
# LLM 호출용 (오케스트레이터·언어화·리스크 검증) — 제공자 확정 후 키 이름 정리
LLM_API_KEY=

# --- Frontend (Vite) ---
# 카카오맵 JS SDK 앱키 (D1: 앱키 발급 + 도메인 등록, '카카오맵 사용 설정' ON)
VITE_KAKAO_APP_KEY=

# --- AI batch (Python) ---
# 공공데이터포털 인증키 (부동산원 신규 API 15099345 등)
DATA_GO_KR_API_KEY=
# 서울 열린데이터광장 인증키
SEOUL_OPEN_DATA_API_KEY=
