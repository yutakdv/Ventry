# ============================================================================
# Ventry 환경변수 — 복사해서 사용:  cp .env.example .env   (.env는 git 미추적)
#
# 사용 규칙
#  - 아래 🔑 항목은 발급받은 키를 `=` 뒤에 그대로 붙여넣기만 하면 된다.
#  - 같은 사이트 계정의 키는 값이 동일해도 API별로 분리해 두었다 (수집 스크립트가
#    소스별 변수를 읽으므로, 동일 키를 여러 칸에 붙여넣어도 된다).
#  - docker compose·Vite(dev)·Python batch 모두 이 루트 .env 하나를 읽는다.
# ============================================================================


# ────────────────────────────────────────────────────────────────────────────
# 1) 카카오맵 (FE-01 · D1 발급)
# ────────────────────────────────────────────────────────────────────────────
# 🔑 [카카오맵 JavaScript SDK 앱키]
#    발급: https://developers.kakao.com/console/app
#    절차: 앱 생성 → 앱 키(JavaScript 키) 복사 → 플랫폼(Web)에 도메인 등록
#          (http://localhost:3000, http://localhost:5173) → '카카오맵 사용 설정' ON
VITE_KAKAO_APP_KEY=


# ────────────────────────────────────────────────────────────────────────────
# 2) 서울 열린데이터광장 (AI-01 · D1 발급, 즉시 발급)
#    회원가입 → 마이페이지 → 인증키 신청: https://data.seoul.go.kr
#    ※ 계정당 인증키 1개로 아래 전 데이터셋 사용 가능 — 같은 키를 각 칸에 붙여넣는다.
# ────────────────────────────────────────────────────────────────────────────
# 🔑 [서울시 상권분석서비스 — 추정매출·길단위인구·상주/직장인구·집객시설·점포·상권변화·영역]
#    데이터: https://data.seoul.go.kr 에서 "상권분석서비스" 검색 (OA-15560~15580 계열 7종)
#    대표(추정매출): https://data.seoul.go.kr/dataList/OA-15560/S/1/datasetView.do
SEOUL_API_KEY_COMMERCIAL=

# 🔑 [서울시 역사마스터 정보 — 지하철역 좌표]
#    데이터: https://data.seoul.go.kr/dataList/OA-21232/S/1/datasetView.do
#    ※ LAT/LOT를 WGS84로 직접 제공해 폴백 소스는 쓰지 않는다 (AI-01 확정 · assumptions #14)
SEOUL_API_KEY_STATION=

# 🔑 [서울시 지하철 호선별 역별 승하차 인원 정보]
#    데이터: https://data.seoul.go.kr/dataList/OA-12914/S/1/datasetView.do
SEOUL_API_KEY_RIDERS=


# ────────────────────────────────────────────────────────────────────────────
# 3) 부동산원 임대동향 — R-ONE 부동산통계정보시스템 (AI-01 · D1 오전 즉시 신청)
#    ⚠️ 2026-07-21 실사 정정: data.go.kr의 부동산원 임대동향 API는 'API 유형: LINK'라
#       공공데이터포털에는 활용신청·인증키가 없다. 실제 키는 R-ONE에서 발급받는다.
#       (data.go.kr 카탈로그 15099345·15134761은 모두 R-ONE으로 연결되는 LINK)
# ────────────────────────────────────────────────────────────────────────────
# 🔑 [한국부동산원 상업용부동산 임대동향 — 임대료·전환율·공실률]  (변수명은 스크립트 호환 위해 유지)
#    발급: https://www.reb.or.kr/r-one/portal/openapi/openApiListPage.do
#          → R-ONE 회원가입/로그인 → Open API 인증키 신청 → '인증키 발급내역'에서 확인
#    호출: REST — https://www.reb.or.kr/r-one/openapi/SttsApiTbl.do?KEY=<키>&STATBL_ID=<통계표>
#          한 키로 STATBL_ID만 바꿔 임대동향·실거래가지수 등 조회 (통계표 코드는 R-ONE 개발가이드)
DATA_GO_KR_API_KEY_REB_RENT=

# [한국부동산원 상권 구획도 SHP — 파일 다운로드, 키 불필요]
#    다운로드: https://www.data.go.kr/data/15086933/fileData.do (2024-10-31판, 368개 상권)
# (키 입력란 없음 — 수동 다운로드 후 ai/data/raw/ 에 배치)

# [지방행정 인허가데이터 (일반음식점·휴게음식점 CSV) — 파일 다운로드, 키 불필요]
#    ⚠️ localdata.go.kr는 2026-04-16 폐쇄 → data.go.kr로 이관.
#    일반음식점: https://www.data.go.kr/data/15045016/fileData.do
#    휴게음식점: https://www.data.go.kr/data/15006730/fileData.do
# (로그인 후 CSV 다운로드, 활용신청 불필요. 좌표 EPSG:5174 → WGS84 변환 필요. ai/data/raw/ 에 배치)


# ────────────────────────────────────────────────────────────────────────────
# 4) 창업비용 통계 (AI-02e → AI-05 「인테리어·시설비 = 업종 상수」의 입력)
#    2026-07-22 실호출 검증. 두 소스는 서로를 보완한다 — 한쪽만으로는 §4-1 블록을 못 채운다.
#    공정위 = 업종 해상도(커피/한식…) 우수 · 가맹점 기준 / KOSIS = 독립창업·국가승인통계 총액
# ────────────────────────────────────────────────────────────────────────────
# 🔑 [공정거래위원회_가맹정보_업종별 창업비용 현황]  ★업종이 '커피'까지 분리됨
#    발급: https://www.data.go.kr/data/15110293/openapi.do → 활용신청 (개발단계 자동승인)
#    호출: GET https://apis.data.go.kr/1130000/FftcSclasIndutyFntnStatsService/<오퍼레이션>
#            getSclaIndutyFntnOutStats   외식 15업종 (커피·음료·제과제빵·한식·분식·주점 등)
#            getSclaIndutyFntnSrvcStats  서비스 22업종 / getSclaIndutyFntnWhrtStats 도소매 7업종
#          ?serviceKey=<키>&yr=2024&resultType=json&pageNo=1&numOfRows=50
#    응답: indutyMlsfcNm(업종) · smtnAmt(창업비용 합계)
#          · avrgJngEtcAmt(기타=필수설비·인테리어·시공·초도물품 → 인테리어·시설 프록시)
#    ⚠️ 필드명이 실제 의미와 어긋난다(2026-07 합 항등식 실증): frcsCnt 는 '가맹점 수'가
#       아니라 **평균 가맹보증금액**이다. 보증금은 이렇게 별도 필드라 avrgJngEtcAmt(기타)에
#       안 섞여 있고 → 우리 보증금 블록과 이중계상되지 않는다
#    ⚠️ crrncyUnitCdNm 라벨은 "(단위 :천원)"이나 실제 단위는 **만원**이다(data.go.kr 메타 버그).
#       근거: 일식 smtnAmt 11,016 = 1.10억(만원, 프랜차이즈 실측 정합) / 천원이면 불가능
#    ⚠️ 가맹점 기준이라 독립 창업 대비 상향(안전 방향). 상세·잔여 합의는 assumptions #21~#23
DATA_GO_KR_API_KEY_FTC_COST=

# 🔑 [KOSIS 소상공인실태조사 — 기업체당 창업비용]  ★독립창업 기준·국가승인통계
#    발급: https://kosis.kr/openapi/ → 회원가입 → 인증키 신청 (공공데이터포털 키와 **별개**)
#    호출: GET https://kosis.kr/openapi/Param/statisticsParameterData.do?method=getList
#          &apiKey=<키>&orgId=142&tblId=DT_3ME0126&itmId=T01+&prdSe=Y
#          &objL1=00+11+          00 전국 · 11 서울특별시
#          &objL2=I+I56+          I 숙박및음식점업 · I56 음식점및주점업
#          &objL3=10+123+5325+    10 기업체수 · 123 기업체당 창업비용 · 5325 본인부담금액
#          &startPrdDe=2023&endPrdDe=2024&format=json&jsonVD=Y
#    ⚠️ **URL 전체가 아니라 apiKey 값만** 넣는다 (나머지 파라미터는 수집 스크립트가 조립)
#    ⚠️ 시도별은 대분류 I까지만 — **서울 × I56 조합은 제공되지 않는다**
KOSIS_API_KEY=


# ────────────────────────────────────────────────────────────────────────────
# 5) LLM — OpenAI API (2026-07-21 변경: Anthropic Claude → OpenAI · BE 서빙 + AI 배치 공용)
# ────────────────────────────────────────────────────────────────────────────
# 🔑 [OpenAI API 키 — 오케스트레이터·탐색 계획·언어화·리스크 검증 + AI-06 배치 추출]
#    발급: https://platform.openai.com/api-keys
#    모델 확정(DECISIONS.md): 서빙(파싱·plan·refine·반박) = gpt-4o-mini (저지연·5s 타임아웃 정합)
#                            배치(정책자금 구조화 추출)   = gpt-4o     (정확도 우선)
#    ※ 비어 있어도 서비스는 템플릿 폴백으로 동작한다 (데모 무중단 설계)
OPENAI_API_KEY=


# ────────────────────────────────────────────────────────────────────────────
# 6) 키 불필요 소스 (참고 — 입력할 것 없음)
# ────────────────────────────────────────────────────────────────────────────
# - 권리금(부동산원 연간 조사): R-ONE 통계표 A_2024_00445 (위 3)의 키로 조회)
# - 정책자금·보증·대출 공고문: 소진공·서울신보·시중은행 공개 페이지 크롤링
# - 서울 상권영역 SHP(폴리곤): https://data.seoul.go.kr OA-15560 파일 다운로드
#   (OpenAPI에는 중심점·면적만 있고 폴리곤이 없다 — docs/assumptions.md #17)


# ────────────────────────────────────────────────────────────────────────────
# 7) 인프라 (로컬 기본값 그대로 사용 가능 — 입력 불필요)
# ────────────────────────────────────────────────────────────────────────────
POSTGRES_DB=ventry
POSTGRES_USER=ventry
POSTGRES_PASSWORD=ventry-local

# Backend JDBC (D3 이후 사용 — compose가 컨테이너 값으로 덮어씀)
DB_URL=jdbc:postgresql://localhost:5432/ventry
DB_USER=ventry
DB_PASSWORD=ventry-local
