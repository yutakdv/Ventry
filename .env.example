# ============================================================================
# Ventry 환경변수 — 이 파일을 복사해서 .env 로 사용 (git 미추적)
#   cp .env.example .env
#
# 🔑 표시된 4개 항목은 반드시 발급받은 키를 입력해야 한다. 발급처·담당·시점 명시.
# ============================================================================

# ----------------------------------------------------------------------------
# PostgreSQL (docker compose) — 로컬 기본값 그대로 사용 가능, 입력 불필요
# ----------------------------------------------------------------------------
POSTGRES_DB=ventry
POSTGRES_USER=ventry
POSTGRES_PASSWORD=ventry-local

# ----------------------------------------------------------------------------
# Backend (Spring Boot) — D3 이후 JDBC 도입 시 사용, 로컬 기본값 사용 가능
# ----------------------------------------------------------------------------
DB_URL=jdbc:postgresql://db:5432/ventry
DB_USER=ventry
DB_PASSWORD=ventry-local

# 🔑 [필수·BE] LLM API 키 — 오케스트레이터·언어화·리스크 검증용
#    발급: 제공자 확정 후(D3 전) 콘솔에서 발급. 없으면 템플릿 폴백으로만 동작.
LLM_API_KEY=🔑여기에_LLM_API_키_입력

# ----------------------------------------------------------------------------
# Frontend (Vite)
# ----------------------------------------------------------------------------
# 🔑 [필수·FE-01, D1] 카카오맵 JavaScript SDK 앱키
#    발급: https://developers.kakao.com → 앱 생성 → 플랫폼(Web) 도메인 등록
#          (localhost:3000, localhost:5173) → '카카오맵 사용 설정' ON
VITE_KAKAO_APP_KEY=🔑여기에_카카오맵_JS_앱키_입력

# ----------------------------------------------------------------------------
# AI batch (Python)
# ----------------------------------------------------------------------------
# 🔑 [필수·AI-01, D1] 공공데이터포털 인증키 — 부동산원 임대료·전환율 신규 API(15099345) 등
#    발급: https://www.data.go.kr → 회원가입 → 활용신청 (승인까지 1~2일 소요 가능, D1 즉시 신청)
DATA_GO_KR_API_KEY=🔑여기에_공공데이터포털_인증키_입력

# 🔑 [필수·AI-01, D1] 서울 열린데이터광장 인증키 — 상권분석 7종·역사마스터·승하차
#    발급: https://data.seoul.go.kr → 로그인 → 인증키 신청 (즉시 발급)
SEOUL_OPEN_DATA_API_KEY=🔑여기에_서울열린데이터광장_인증키_입력
